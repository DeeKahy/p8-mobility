{
  "name": "p8-mobility",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "ci:check": "npm run type-check && npm run lint && npm run format:check",
    "android": "expo run:android",
    "test": "jest --watchAll",
    "test:e2e": "maestro test .maestro/ --platform=web",
    "test:e2e:main": "maestro test .maestro/main-screen.yaml --platform=web",
    "test:e2e:nav": "maestro test .maestro/navigation-flow.yaml --platform=web",
    "test:e2e:smoke": "maestro test .maestro/smoke-test.yaml --platform=web",
    "test:e2e:web": "npm run web & sleep 10 && maestro test .maestro/ --platform=web && pkill -f 'expo start'"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@turf/area": "^7.3.4",
    "@types/jest": "29.5.14",
    "@viro-community/react-viro": "^2.41.1",
    "buffer": "^6.0.3",
    "eslint": "^9.39.3",
    "eslint-config-universe": "^15.0.3",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "^55.0.15",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.81.5",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "upng-js": "^2.1.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.0",
    "@types/upng-js": "^2.1.5",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.9",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "@expo/fingerprint": "0.15.4",
    "react-test-renderer": "19.1.0"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "private": true
}
